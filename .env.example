# ==========================================================
# Srikrishna Seva Niketan — Backend API
# Copy this file to `.env` and fill in REAL values locally.
# `.env` is git-ignored and must NEVER be committed.
# ==========================================================

# ---- Application ----
APP_NAME="Srikrishna Seva Niketan"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# ---- Security / JWT ----
# Generate a strong key: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace_with_python_secrets_token_urlsafe_64
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_EXPIRE_MINUTES=30

# ---- Database (MongoDB) ----
# Local:  mongodb://localhost:27017
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=srikrishna_seva_niketan

# ---- Cloudinary (media uploads) ----
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# ---- Email (SMTP) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME="Srikrishna Seva Niketan"
SMTP_TLS=true
SMTP_SSL=false
ADMIN_NOTIFICATION_EMAIL=your_email@gmail.com

# ---- CORS (comma-separated origins) ----
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# ---- Rate limiting ----
RATE_LIMIT_DEFAULT=200/minute
RATE_LIMIT_AUTH=10/minute

# ---- Frontend URL (password-reset links etc.) ----
FRONTEND_URL=http://localhost:8080

# ---- First / bootstrap super-admin (created on first run) ----
FIRST_ADMIN_NAME="Super Admin"
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=ChangeMe@StrongPass1!

# Ola Maps (Krutrim) — server-side only: geocoding + directions
OLA_MAPS_API_KEY=
